# Copy to .env and fill in. Everything has a working fallback, so the app,
# API, RAG, verification, benchmark and tests all run even with this file empty.

# --- API / auth ---
JWT_SECRET=change-me-to-a-long-random-32+byte-string
JWT_TTL_MIN=120
API_BASE_URL=http://127.0.0.1:5000

# --- Cache (leave REDIS_URL empty to use the in-memory fallback) ---
REDIS_URL=
CACHE_TTL_SEC=60

# --- Celery async (leave empty to run tasks inline/eager) ---
CELERY_BROKER_URL=

# --- Voice stack (needed only to run the live LiveKit worker) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The account the agent books on behalf of (a real user in your DB)
AGENT_USER_EMAIL=
AGENT_USER_PASSWORD=

# Models / voice
LLM_MODEL=gpt-4o-mini
TTS_VOICE=alloy
ASR_MODEL=nova-2
ASR_LANGUAGE=multi
EMBED_MODEL=text-embedding-3-small

# Set to 1 (with keys) to make the benchmark/RAG use real calls
RUN_LIVE=0
